+// C119 (0) DIAGNOSTIC ONLY (tools/C118_diag.diff): a per-closure byte audit. Buf carries both the
+// face size and its element size (struct Buf { void* p; size_t bytes; size_t esz; ... } at :111), so
+// one hook at the pgraph_ids choke point (18 recorder call sites) gives, for every closure, which
+// faces it touches, how many bytes each, and at what element width -- exactly what the P8 decision
+// needs before ANY face is re-typed. Env-gated: NR_BYTE_AUDIT=1.
+static std::map<int, std::vector<std::pair<int, unsigned>>> g_audit;   // closure idx -> (bufid, esz)
+static void audit_note(int id) {
+    if (!getenv("NR_BYTE_AUDIT")) return;
+    int ci = (int)g_cmds.size();
+    auto& v = g_audit[ci];
+    for (auto& pr : v) if (pr.first == id) return;          // once per face per closure
+    auto it = g_bufs.find(id);
+    if (it == g_bufs.end()) return;
+    v.push_back({ id, (unsigned)it->second.esz });
+}
 static void pgraph_ids(std::initializer_list<int> ids) {
+    for (int id : ids) audit_note(id);
+
     g_pg_pending.clear();
     g_pg_pending_ids.clear();
     pg_note_ids(ids);
