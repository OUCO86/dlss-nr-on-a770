+// ---- C15: capture-time PRUNE of dissolved closures (NR_PRUNE_DISSOLVED=1) ----------------
+// The dissolved closures carry ZERO device submissions, so dropping them from the stream changes
+// the HOST-side closure list only. What must stay identical is (i) the device op stream, (ii) the
+// scratch-pool block sequence, (iii) the per-closure touch/ids registries of the SURVIVING
+// closures. So the prune compacts every per-capture parallel vector in the same order (rule 57),
+// compacts the g_cmd_names TAIL that belongs to this capture (name_offset = names - closures),
+// and renumbers the skip witness g_skipped_cmds. It runs AFTER skip_chains_apply / bmerge_apply /
+// the report dumps, so those all still see the pre-prune indices.
+// Refused (and said so) if NR_BMERGE_ORDER permuted the stream: g_cmds_dissolved holds PRE-reorder
+// indices and a stale index would drop the wrong closure.
+static void prune_dissolved_apply(int gid) {
+    size_t n = g_cmds.size(), nd = 0;
+    for (size_t i = 0; i < n; ++i) if (g_cmds_dissolved.count(i)) ++nd;
+    bool report = getenv("NR_C15_REPORT") != nullptr || prune_dissolved_on();
+    if (report)
+        std::printf("[c15] graph=%d closures=%zu dissolved=%zu skip_noop=%zu switch=%d\n",
+                    gid, n, nd, g_skipped_cmds.size(), (int)prune_dissolved_on());
+    if (!prune_dissolved_on() || nd == 0) { std::fflush(stdout); return; }
+    if (!g_order_moves.empty()) {
+        std::printf("[c15] graph=%d REFUSED: %zu order moves make the dissolve indices stale\n",
+                    gid, g_order_moves.size()); std::fflush(stdout); return; }
+    std::vector<char> drop(n, 0);
+    for (size_t i = 0; i < n; ++i) if (g_cmds_dissolved.count(i)) drop[i] = 1;
+    std::vector<size_t> map(n, SIZE_MAX);
+    size_t kept = 0;
+    for (size_t i = 0; i < n; ++i) if (!drop[i]) map[i] = kept++;
+    auto comp = [&](auto& v) {
+        size_t w = 0, m = v.size() < n ? v.size() : n;
+        for (size_t i = 0; i < m; ++i) if (!drop[i]) { if (w != i) v[w] = std::move(v[i]); ++w; }
+        if (v.size() != m) { std::printf("[c15] VECTOR-SHORT size=%zu closures=%zu -- prune skipped\n", v.size(), n); return; }
+        v.resize(w);
+    };
+    comp(g_cmds); comp(g_cmds_touch); comp(g_cmds_group); comp(g_pg_ids_snap);
+    comp(g_cmds_launch); comp(g_cmds_name); comp(g_cmds_poolblk);
+    size_t noff = g_cmd_names.size() >= n ? g_cmd_names.size() - n : 0;
+    std::vector<const char*> tail; tail.reserve(kept);
+    for (size_t i = 0; i < n; ++i) if (!drop[i]) tail.push_back(g_cmd_names[noff + i]);
+    g_cmd_names.resize(noff);
+    for (size_t i = 0; i < tail.size(); ++i) g_cmd_names.push_back(tail[i]);
+    std::set<size_t> sk;
+    for (size_t i : g_skipped_cmds) if (i < n && map[i] != SIZE_MAX) sk.insert(map[i]);
+    g_skipped_cmds = std::move(sk);
+    std::printf("[c15] graph=%d pruned=%zu passes %zu -> %zu\n", gid, nd, n, kept);
+    std::fflush(stdout);
+}
