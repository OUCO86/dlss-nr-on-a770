+// C123 (merged diag): per-closure byte audit. Buf carries bytes + esz (struct Buf at :111), so one
+// hook at the pgraph_ids choke point gives, for every closure, which faces it touches and at what
+// element width. Env-gated by NR_BYTE_AUDIT=1. DIAG ONLY: never staged, never a revenue knife.
+static std::map<int, std::vector<std::pair<int, unsigned>>> g_audit;
+static void audit_note(int id) {
+    if (!getenv("NR_BYTE_AUDIT")) return;
+    int ci = (int)g_cmds.size();
+    auto& v = g_audit[ci];
+    for (auto& pr : v) if (pr.first == id) return;
+    auto it = g_bufs.find(id);
+    if (it == g_bufs.end()) return;
+    v.push_back({ id, (unsigned)it->second.esz });
+}
+static void audit_chain(int chain, size_t a, size_t b) {
+    if (!getenv("NR_BYTE_AUDIT")) return;
+    std::map<int, unsigned long long> per;
+    unsigned long long tot = 0;
+    for (size_t i = a; i <= b; ++i) {
+        auto it = g_audit.find((int)i);
+        if (it == g_audit.end()) continue;
+        for (auto& pr : it->second) {
+            auto bf = g_bufs.find(pr.first);
+            if (bf == g_bufs.end()) continue;
+            per[pr.first] += bf->second.bytes; tot += bf->second.bytes;
+        }
+    }
+    std::printf("[byte-audit] chain=%d totalMB=%.1f faces=", chain, tot / 1e6);
+    for (auto& f : per)
+        std::printf(" %d:%.1fMB(w%u)", f.first, f.second / 1e6,
+                    (unsigned)(g_bufs.count(f.first) ? g_bufs[f.first].esz : 0));
+    std::printf("\n");
+    std::fflush(stdout);
+}
 static void pgraph_ids(std::initializer_list<int> ids) {
+    for (int id : ids) audit_note(id);
     g_pg_pending.clear();
     g_pg_pending_ids.clear();
     pg_note_ids(ids);
@@ -1421,6 +1455,9 @@ int xmx_buf_create_kind(unsigned long long bytes, int kind) {
