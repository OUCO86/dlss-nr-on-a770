#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * resident — the elementwise half of the graph, addressed by pointer.
 *
 * Every buffer arrives as a 64-bit device address in the push constants, so there
 * are no descriptor sets and a whole block's worth of dispatches can be recorded
 * into one command buffer without touching a descriptor pool. On this shared-memory
 * APU the buffers are HOST_CACHED, so "upload" is an address rather than a transfer.
 *
 * `precise` is not decoration here: the vendor's gate rounds to half between the
 * multiply and the add, and an FMA contraction would skip that rounding and give a
 * different answer from the reference.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "publish.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf  { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float     v[]; };
/* The game's frame as it arrives: one whole BGRA pixel per word, which is how the
 * request crosses the pipe and how it can be handed to the device without a decode
 * on the host. Only the two request passes read it. */
layout(buffer_reference, scalar, buffer_reference_align = 4)  buffer U32Buf   { uint      v[]; };

layout(push_constant, scalar) uniform Push {
    FloatBuf a, b, c, d;
    uint m, n, k, batch;
    uint sa, sb, sc, flags;
    float p0, p1, p2, p3;
    uint lda, ldb, ldc, spare;                 // the GEMMs'; unused here
    uint64_t second;                           // offset 96: a pass's second output
} pc;

#include "specialize.glsl"

// kinds
const uint E4M3 = 0u, GATE = 1u, HALF = 2u, TO_HALF = 3u, SCALE = 4u,
           RESIDUAL = 5u, FROM_HALF = 6u, PARTITION = 7u, REVERSE = 8u, ADD_BIAS = 9u,
           SPLIT_HEADS = 10u, MERGE_HEADS = 11u, POOL2 = 12u, UPSAMPLE2 = 13u,
           SCALE_CHANNEL = 14u, ADD = 15u, PAD_END = 16u,
           /* fused: one read of float32 and one write of float16 where the graph
            * otherwise makes three round trips over the same buffer */
           GATE_E4M3_HALF = 17u, E4M3_HALF = 18u, GATE_HALF = 19u,
           UPSAMPLE_MERGE = 20u, UPSAMPLE_ADD = 21u, POOL2_SKIP = 22u,
           /* the request's two own passes, which take the frame from the game's bytes
            * to the sixteen channels the graph reads without the host touching a pixel:
            * PRE_INNER decodes and resamples, PRE_FEATURES assembles and narrows. */
           PRE_INNER = 23u, PRE_FEATURES = 24u, POST_COMPOSE = 25u;

/* Flags above the ones the graph's passes share, so nothing here can be read as an
 * epilogue or an operand width. Bit 24 is BGRA byte order, 25 a previous inner to
 * difference against, 26 a history for feature channels 7-9. */
const uint F_BGRA = 0x1000000u, F_PREVIOUS = 0x2000000u, F_HISTORY = 0x4000000u;
const uint F_GRADE = 0x8000000u, F_NEURAL = 0x10000000u;

shared float partial_sum[256];



/* The publish a pass ends with: bits 8-11 of `flags` pick the transform and bit 12
 * narrows the output to float16. Folding it in here is what lets `partition`,
 * `split_heads`, `merge_heads` and the row passes feed a GEMM directly, instead of
 * writing float32 for a `to_half` pass to read straight back. */
/* An operand held as float16. A published value is E4M3 and therefore exact in half —
 * measured, `src/bench/bf16_check.py` — so a buffer the graph publishes can be stored
 * narrow and read back here with nothing lost. Bit 15 marks `a`, bit 16 marks `b`. */
float load_a(uint index) {
    return (operation_flags() & 0x8000u) != 0u ? float(HalfBuf(uint64_t(pc.a)).v[index]) : pc.a.v[index];
}

float load_b(uint index) {
    return (operation_flags() & 0x10000u) != 0u ? float(HalfBuf(uint64_t(pc.b)).v[index]) : pc.b.v[index];
}

void store(uint index, float value) {
    uint epilogue = (operation_flags() >> 8) & 0xFu;
    if (epilogue == 2u || epilogue == 3u) value = gate_activation(value);
    if (epilogue == 1u || epilogue == 3u) value = e4m3(value);
    if (epilogue == 4u) value = half_round(value);
    if ((operation_flags() & 0x1000u) != 0u) HalfBuf(uint64_t(pc.c)).v[index] = float16_t(value);
    else                            pc.c.v[index] = value;
}

/* Toward zero onto the half grid, which is what the vendor's RGBA16F history keeps of
 * the prediction (`nr_frame.truncate_half`). This is bit manipulation, *not* a
 * rounding: a normal half keeps ten mantissa bits, a subnormal one is a multiple of
 * 2^-24. `float16_t(x)` would round to nearest-even and give a different answer. */
float truncate_half(float x) {
    uint f = floatBitsToUint(x);
    float kept = uintBitsToFloat(f & 0xffffe000u);
    float small = floor(abs(x) * 16777216.0) * exp2(-24.0);
    small = x < 0.0 ? -small : small;
    return (f & 0x7fffffffu) >= 0x38800000u ? kept : small;
}

float grade_unit(float value) {
    value = value < 0.0 ? 0.0 : value;
    return value > 1.0 ? 1.0 : value;
}

float hue_channel(float p, float q, float t) {
    float up = t + 1.0;
    t = t < 0.0 ? up : t;
    float down = t - 1.0;
    t = t > 1.0 ? down : t;
    float rising = p + t * ((q - p) * 6.0);
    float falling = p + (2.0 / 3.0 - t) * (q - p) * 6.0;
    return t < 1.0 / 6.0 ? rising : t < 0.5 ? q : t < 2.0 / 3.0 ? falling : p;
}

/* The vendor's colour grade for a style on one pixel, `nr_frame.style_grade`
 * operation for operation: an exposure and a smoothstep contrast per channel, then a
 * saturation multiplier in HSL. Every branch is a select, as NumPy's `where` computes
 * both sides — the unused one on a stand-in divisor — so the fused rows vectorise it,
 * and so must this. */
void style_grade(inout float c[3], float exposure, float contrast, float saturation) {
    for (int i = 0; i < 3; ++i) {
        float v = grade_unit(grade_unit(c[i]) * exposure);
        c[i] = grade_unit(v + contrast * (v * v * (3.0 - (v + v)) - v));
    }
    float r = c[0], g = c[1], b = c[2];
    float high = r > g ? r : g, low = r < g ? r : g;
    high = high > b ? high : b;
    low = low < b ? low : b;
    float light = (high + low) * 0.5;
    float delta = high - low;
    bool grey = !(high > low);
    float spread = grey ? 1.0 : delta;
    float bright = (2.0 - high) - low, dark = high + low;
    float by_bright = delta / (grey ? 1.0 : bright), by_dark = delta / (grey ? 1.0 : dark);
    float chroma = light > 0.5 ? by_bright : by_dark;
    float from_r = ((g - b) / spread + (g < b ? 6.0 : 0.0)) / 6.0;
    float from_g = ((b - r) / spread + 2.0) / 6.0;
    float from_b = ((r - g) / spread + 4.0) / 6.0;
    float hue = grey ? 0.0 : high == r ? from_r : high == g ? from_g : from_b;
    chroma = grade_unit((grey ? 0.0 : chroma) * saturation);
    float q_dark = light * (chroma + 1.0), q_bright = (light + chroma) - light * chroma;
    float q = light < 0.5 ? q_dark : q_bright;
    float p = (light + light) - q;
    bool drained = chroma <= 0.0;
    float lit = grade_unit(light);
    c[0] = drained ? lit : grade_unit(hue_channel(p, q, hue + 1.0 / 3.0));
    c[1] = drained ? lit : grade_unit(hue_channel(p, q, hue));
    c[2] = drained ? lit : grade_unit(hue_channel(p, q, hue - 1.0 / 3.0));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint kind = operation_flags() & 0xFFu;

    /* Both request passes are read before the extent test: PRE_INNER ends in a
     * workgroup reduction, whose barriers every invocation of the group has to
     * reach, including the ones past the end. */
    if (kind == PRE_INNER) {
        /* The game's bytes into the network's input extent: one BGRA word to three
         * floats, then the two bilinear axes the host ran one after the other. One
         * pass, but their order kept — the row pair first, then the column pair over
         * those two results — because float32 addition is not associative and
         * `nr_resize_axis` writes its intermediate out as float32 between the two.
         * `b` carries the six gather tables; `d` is the frame before's inner, and
         * `second` takes one partial sum of |this - that| a workgroup, which is what
         * the cut test averages. */
        uint width = pc.sa, height = pc.sb, source_w = pc.sc, source_h = pc.k;
        uint x = index % width, y = index / width, table = 3u * height;
        /* The host's own `(float)byte / 255.0f`, all 256 of them, at the end of the
         * plan. A division here is a multiply by the reciprocal once this compiler
         * has seen the constant, and that disagrees with the host in the last bit on
         * about half the values — measured, and the whole reason this is a table. */
        uint scale_at = pc.batch;
        int row_low = floatBitsToInt(pc.b.v[y]);
        int row_high = floatBitsToInt(pc.b.v[height + y]);
        float row_weight = pc.b.v[2u * height + y];
        int col_low = floatBitsToInt(pc.b.v[table + x]);
        int col_high = floatBitsToInt(pc.b.v[table + width + x]);
        float col_weight = pc.b.v[table + 2u * width + x];
        float moved = 0.0;
        if (index < pc.m) {
            U32Buf raw = U32Buf(pc.a);
            for (uint c = 0u; c < 3u; c++) {
                /* bytes 2, 1, 0 as the host reads R, G, B out of a BGRA word */
                uint shift = (operation_flags() & F_BGRA) != 0u ? 16u - 8u * c : 8u * c;
                float corner[4];
                corner[0] = pc.b.v[scale_at + ((raw.v[uint(row_low) * source_w + uint(col_low)]
                                                >> shift) & 0xFFu)];
                corner[1] = pc.b.v[scale_at + ((raw.v[uint(row_high) * source_w + uint(col_low)]
                                                >> shift) & 0xFFu)];
                corner[2] = pc.b.v[scale_at + ((raw.v[uint(row_low) * source_w + uint(col_high)]
                                                >> shift) & 0xFFu)];
                corner[3] = pc.b.v[scale_at + ((raw.v[uint(row_high) * source_w + uint(col_high)]
                                                >> shift) & 0xFFu)];
                precise float low = corner[0] * (1.0 - row_weight) + corner[1] * row_weight;
                precise float high = corner[2] * (1.0 - row_weight) + corner[3] * row_weight;
                precise float value = low * (1.0 - col_weight) + high * col_weight;
                pc.c.v[index * 3u + c] = value;
                if ((operation_flags() & F_PREVIOUS) != 0u)
                    moved += abs(value - pc.d.v[index * 3u + c]);
            }
        }
        if ((operation_flags() & F_PREVIOUS) != 0u) {
            /* One sum a workgroup, added by the host: the cut test wants a mean over
             * the whole extent, and this way nothing waits on the device for it. */
            partial_sum[gl_LocalInvocationID.x] = moved;
            barrier();
            for (uint stride = 128u; stride > 0u; stride >>= 1u) {
                if (gl_LocalInvocationID.x < stride)
                    partial_sum[gl_LocalInvocationID.x] += partial_sum[gl_LocalInvocationID.x + stride];
                barrier();
            }
            if (gl_LocalInvocationID.x == 0u)
                FloatBuf(uint64_t(pc.second)).v[gl_WorkGroupID.x] = partial_sum[0];
        }
        return;
    }
    if (kind == PRE_FEATURES) {
        /* The sixteen channels of one pixel, in half: the mirror onto the network
         * extent, the three roundings of `scaled_color`, and the history that stands
         * in channels 7-9, as `nr_features_half` computes them. `b` carries the row
         * gather, then the column gather, then the noise, then the five controls. */
        uint width = pc.sa, inner_w = pc.sb, columns_at = pc.sc;
        uint noise_at = pc.k, controls_at = pc.batch;
        uint x = index % width, y = index / width;
        uint at = (uint(floatBitsToInt(pc.b.v[y])) * inner_w
                   + uint(floatBitsToInt(pc.b.v[columns_at + x]))) * 3u;
        bool history = (operation_flags() & F_HISTORY) != 0u;
        float values[16];
        for (uint c = 0u; c < 3u; c++) {
            float scaled = half_round(half_round(half_round(pc.a.v[at + c]) - 0.5) * 0.125);
            values[c] = pc.b.v[noise_at + index * 3u + c];
            values[4u + c] = scaled;
            values[7u + c] = history
                ? half_round(half_round(half_round(pc.d.v[at + c]) - 0.5) * 0.125)
                : scaled;
        }
        values[3u] = 1.0;
        for (uint c = 0u; c < 5u; c++) values[10u + c] = pc.b.v[controls_at + c];
        values[15u] = 0.0;
        HalfBuf target = HalfBuf(uint64_t(pc.c));
        for (uint c = 0u; c < 16u; c++)
            target.v[index * 16u + c] = float16_t(values[c]);
        return;
    }
    if (kind == POST_COMPOSE) {
        /* The answer: the head brought up to the frame and composed against it, then
         * encoded into the bytes the game is handed back. `a` is the request's own
         * words, which is where the colour comes from — no decode ever reaches the
         * host. `b` is the head, `c` one block holding the two gather tables, the
         * 256 byte values, the 65536-entry gate table and the scalars, `d` the frame
         * before's composition followed by its pixels, and `second` one block taking
         * the composition, the neural prediction, the change's partial sums, the head
         * samples and the encoded words. Read before the extent test: it ends in a
         * workgroup reduction whose barriers every invocation must reach. */
        uint width = pc.sa, height = pc.sb, source_w = pc.sc;
        uint head_w = pc.k, head_h = pc.batch, channels = pc.n;
        uint x = index % width, y = index / width, at = y * width + x;
        uint x_at = 3u * height, decode_at = x_at + 3u * width;
        uint gate_at = decode_at + 256u, scalar_at = gate_at + 65536u;
        uint flags = operation_flags();
        bool held = (flags & F_HISTORY) != 0u, moved_before = (flags & F_PREVIOUS) != 0u;
        bool do_grade = (flags & F_GRADE) != 0u, do_neural = (flags & F_NEURAL) != 0u;
        bool bgra = (flags & F_BGRA) != 0u;
        FloatBuf par = pc.c, answer = FloatBuf(uint64_t(pc.second));
        U32Buf raw = U32Buf(pc.a), words = U32Buf(uint64_t(pc.second));
        float intensity = par.v[scalar_at], scale = par.v[scalar_at + 1u];
        float hold = par.v[scalar_at + 2u], slope = par.v[scalar_at + 3u];
        float release = par.v[scalar_at + 4u], confidence = par.v[scalar_at + 5u];
        uint top = uint(par.v[scalar_at + 6u]), left = uint(par.v[scalar_at + 7u]);
        uint frame_w = uint(par.v[scalar_at + 8u]);
        uint change_rows = uint(par.v[scalar_at + 9u]), step = uint(par.v[scalar_at + 10u]);
        uint samples_at = uint(par.v[scalar_at + 11u]);
        uint encoded_at = uint(par.v[scalar_at + 12u]);
        uint partial_at = uint(par.v[scalar_at + 13u]);
        uint neural_at = uint(par.v[scalar_at + 14u]);
        float grade[3] = float[3](par.v[scalar_at + 15u], par.v[scalar_at + 16u],
                                  par.v[scalar_at + 17u]);

        /* `d` is the frame before: its composition at `at * 3`, in float32, and then
         * at `pc.m * 3` the *words it was given*, four bytes a pixel rather than the
         * twelve a decoded float32 triple would take. They are decoded here through
         * the same 256 values the frame's own bytes go through, so the answer is the
         * one `decode8` would have given — and 8.3 MB crosses the bus instead of 25,
         * in a buffer the request had already uploaded anyway. */
        /* The head up, both axes: the row pair first and the column pair over those
         * two, which is `nr_resize_axis` twice and is not associative. */
        int row_low = floatBitsToInt(par.v[y]), row_high = floatBitsToInt(par.v[height + y]);
        float row_w = par.v[2u * height + y];
        int col_low = floatBitsToInt(par.v[x_at + x]);
        int col_high = floatBitsToInt(par.v[x_at + width + x]);
        float col_w = par.v[x_at + 2u * width + x];
        float h[4] = float[4](0.0, 0.0, 0.0, 0.0);
        if (index < pc.m) {
            for (uint c = 0u; c < channels; c++) {
                float a0 = pc.b.v[(uint(row_low) * head_w + uint(col_low)) * channels + c];
                float a1 = pc.b.v[(uint(row_high) * head_w + uint(col_low)) * channels + c];
                float a2 = pc.b.v[(uint(row_low) * head_w + uint(col_high)) * channels + c];
                float a3 = pc.b.v[(uint(row_high) * head_w + uint(col_high)) * channels + c];
                precise float low = a0 * (1.0 - row_w) + a1 * row_w;
                precise float high = a2 * (1.0 - row_w) + a3 * row_w;
                h[c] = low * (1.0 - col_w) + high * col_w;
            }
        }

        /* The colour: the request's own bytes, through the host's 256 values. */
        uint pixel = (top + y) * frame_w + left + x;
        uint word = index < pc.m ? raw.v[pixel] : 0u;
        float rgb[3], predicted[3];
        for (uint c = 0u; c < 3u; c++) {
            uint shift = bgra ? 16u - 8u * c : 8u * c;
            rgb[c] = par.v[decode_at + ((word >> shift) & 0xFFu)];
            /* The prediction, and the half the vendor rounds the head to before the
             * quarter it is scaled by. Round-to-nearest-even, unlike the truncation
             * `finish_pixel` does later. */
            predicted[c] = clamp(rgb[c] + float(float16_t(h[c])) * 0.25, 0.0, 1.0);
        }

        float alpha = 0.0;
        if (held && index < pc.m) {
            /* How far the game moved this pixel: the largest step of the three. The
             * release and the floor both read it. */
            float moved = 0.0;
            if (moved_before) {
                /* The frame before's own bytes, decoded through the table the frame's
                 * own went through: `decode8` of the payload the host kept would give
                 * these three floats exactly. */
                uint before = U32Buf(uint64_t(pc.d)).v[pc.m * 3u + pixel];
                for (uint c = 0u; c < 3u; c++) {
                    uint was_shift = bgra ? 16u - 8u * c : 8u * c;
                    float was = par.v[decode_at + ((before >> was_shift) & 0xFFu)];
                    float d = rgb[c] - was;
                    moved = max(moved, abs(d));
                }
            }
            /* The gate, looked up rather than recomputed: the logit's sixteen bits,
             * which is why the exponential can stay in the host's table. */
            uint bits = packHalf2x16(vec2(float16_t(h[3]), float16_t(0.0))) & 0xFFFFu;
            alpha = par.v[gate_at + bits];
            if (confidence != 1.0) alpha *= confidence;
            if (moved_before && release != 0.0)
                alpha *= clamp(moved * release + 1.0, 0.0, 1.0);
            if (moved_before) {
                /* `moved * slope + hold` clamped to [0, hold] and to 1, then scaled:
                 * `clip(1 - moved * 255 / ramp, 0, 1) * hold` is the same by algebra
                 * and a different float32, so the folded slope is what arrives. */
                float floored = clamp(moved * slope + hold, 0.0, hold);
                alpha = max(alpha, min(floored, 1.0) * scale);
            }
            for (uint c = 0u; c < 3u; c++)
                predicted[c] += alpha * (pc.d.v[at * 3u + c] - predicted[c]);
        }

        float composed[3], difference = 0.0;
        if (index < pc.m) {
            if (do_grade || do_neural) {
                float kept[3];
                for (uint c = 0u; c < 3u; c++) kept[c] = truncate_half(predicted[c]);
                if (do_neural)
                    for (uint c = 0u; c < 3u; c++) answer.v[neural_at + at * 3u + c] = kept[c];
                if (do_grade) {
                    style_grade(kept, grade[0], grade[1], grade[2]);
                    for (uint c = 0u; c < 3u; c++) predicted[c] = kept[c];
                }
            }
            for (uint c = 0u; c < 3u; c++) {
                /* No clamp on the blend: the vendor's is the one thing our
                 * composition drops, so that intensity above 1 extrapolates. */
                composed[c] = clamp(rgb[c] + intensity * (predicted[c] - rgb[c]), 0.0, 1.0);
                answer.v[at * 3u + c] = composed[c];
            }
            /* Encoded at its place in the whole frame, with the request's alpha and
             * with everything outside the active region left as it came. */
            uint packed = raw.v[pixel] & 0xFF000000u;
            for (uint c = 0u; c < 3u; c++) {
                float value = composed[c];
                /* NumPy's byte cast maps NaN to zero; do not cast NaN. */
                value = value == value ? clamp(value, 0.0, 1.0) : 0.0;
                /* `precise` because this is the one place a contraction shows: the
                 * host computes the product and the sum in two steps, and an FMA
                 * lands a different side of a .5 on about five bytes in eight
                 * million. The byte is the only thing the game ever sees. */
                precise float rounded = value * 255.0 + 0.5;
                packed |= uint(rounded) << (bgra ? 16u - 8u * c : 8u * c);
            }
            words.v[encoded_at + pixel] = packed;
            if (change_rows > 0u && y % change_rows == 0u)
                for (uint c = 0u; c < 3u; c++) difference += abs(composed[c] - rgb[c]);
            if (step > 0u && y % step == 0u && x % step == 0u) {
                uint sampled = (width + step - 1u) / step;
                uint to = samples_at + ((y / step) * sampled + x / step) * channels;
                for (uint c = 0u; c < channels; c++) answer.v[to + c] = h[c];
            }
        }
        if (change_rows > 0u) {
            partial_sum[gl_LocalInvocationID.x] = difference;
            barrier();
            for (uint stride = 128u; stride > 0u; stride >>= 1u) {
                if (gl_LocalInvocationID.x < stride)
                    partial_sum[gl_LocalInvocationID.x] += partial_sum[gl_LocalInvocationID.x + stride];
                barrier();
            }
            if (gl_LocalInvocationID.x == 0u)
                answer.v[partial_at + gl_WorkGroupID.x] = partial_sum[0];
        }
        return;
    }
    if (index >= pc.m) return;

    if (kind == GATE_E4M3_HALF || kind == E4M3_HALF || kind == GATE_HALF) {
        float value = pc.a.v[index];
        if (kind != E4M3_HALF) value = gate_activation(value);
        if (kind != GATE_HALF) value = e4m3(value);
        // an E4M3 value is exact in half, and the gate already returns a half value,
        // so the narrowing here loses nothing either way
        HalfBuf(uint64_t(pc.c)).v[index] = float16_t(value);
        return;
    }
    if (kind == TO_HALF) {
        HalfBuf(uint64_t(pc.c)).v[index] = float16_t(pc.a.v[index] * pc.p0);
        return;
    }
    if (kind == FROM_HALF) {
        store(index, float(HalfBuf(uint64_t(pc.a)).v[index]) * pc.p0);
        return;
    }
    if (kind == RESIDUAL) {
        /* out = branch + skip * cosine, the cosine one value per channel. Bit 14 makes
         * the branch read through the window reverse, so the attention output goes
         * straight into the residual instead of being copied into image order first. */
        uint at = index;
        if ((operation_flags() & 0x4000u) != 0u) {
            uint channels = pc.n, size = pc.batch, width = pc.sb, across = pc.sc;
            uint c = index % channels, rest = index / channels;
            uint py = rest / width + (pc.k >> 16), px = rest % width + (pc.k & 0xFFFFu);
            at = (((py / size) * across + px / size) * size * size
                  + (py % size) * size + px % size) * channels + c;
        }
        store(index, load_a(at) + load_b(index) * pc.d.v[index % pc.n]);
        return;
    }
    if (kind == PARTITION || kind == REVERSE) {
        /* NHWC <-> (window, token, channel), with the shifted-window origin folded in
         * rather than materialised as a padded copy. `k` carries the pad as
         * (top << 16) | left; a window that reaches outside the image reads zero, which
         * is what `functional.pad` would have put there. */
        uint channels = pc.n, size = pc.batch;
        uint height = pc.sa, width = pc.sb, across = pc.sc;
        uint pad_top = pc.k >> 16, pad_left = pc.k & 0xFFFFu;
        uint c = index % channels, rest = index / channels;
        if (kind == PARTITION) {
            uint token = rest % (size * size), window = rest / (size * size);
            int y = int((window / across) * size + token / size) - int(pad_top);
            int x = int((window % across) * size + token % size) - int(pad_left);
            store(index, (y < 0 || x < 0 || y >= int(height) || x >= int(width))
                ? 0.0 : load_a((uint(y) * width + uint(x)) * channels + c));
        } else {
            uint x = rest % width, y = rest / width;
            uint py = y + pad_top, px = x + pad_left;
            uint window = (py / size) * across + (px / size);
            uint token = (py % size) * size + (px % size);
            store(index, load_a((window * size * size + token) * channels + c));
        }
        return;
    }
    if (kind == POOL2) {
        // 2x2 average, NHWC. n=channels, sb=source width.
        uint channels = pc.n, width = pc.sb;
        uint c = index % channels, rest = index / channels;
        uint x = rest % (width / 2u), y = rest / (width / 2u);
        uint base = ((2u * y) * width + 2u * x) * channels + c;
        /* The reference adds the four taps column-first — (top-left + bottom-left) +
         * top-right + bottom-right — and float32 addition is not associative, so the
         * order is part of the answer. `precise` keeps the compiler from regrouping. */
        precise float total = load_a(base) + load_a(base + width * channels);
        total += load_a(base + channels);
        total += load_a(base + (width + 1u) * channels);
        store(index, total * 0.25);
        return;
    }
    if (kind == UPSAMPLE2) {
        // nearest 2x, cropped to the target extent. n=channels, sa=target width,
        // sb=source width.
        uint channels = pc.n, target = pc.sa, source = pc.sb;
        uint c = index % channels, rest = index / channels;
        uint x = rest % target, y = rest / target;
        store(index, load_a(((y / 2u) * source + (x / 2u)) * channels + c));
        return;
    }
    if (kind == UPSAMPLE_MERGE) {
        /* Block 70's input in one pass: the level above, upsampled 2x (nearest), times the
         * per-channel sin, plus the full-resolution skip times the per-channel cos. That
         * was upsample2, scale_channel, residual and to_half — four passes over a full
         * frame, three of them writing float32 for the next to read back. The steps and
         * their roundings are theirs: the scale is rounded on its own (`precise`), and the
         * residual is the fused multiply-add the RESIDUAL pass compiles to, which is
         * measured rather than assumed (notes/improve-fusions.md). The float32 result is
         * the feed-forward's residual; the copy, published to E4M3, is its GEMM's input.
         * n=channels, sa=target width, sb=source width; d holds sin then cos. */
        uint channels = pc.n, target = pc.sa, source = pc.sb;
        uint c = index % channels, rest = index / channels;
        uint x = rest % target, y = rest / target;
        precise float scaled = load_a(((y / 2u) * source + (x / 2u)) * channels + c)
                             * pc.d.v[c];
        float merged = fma(load_b(index), pc.d.v[channels + c], scaled);
        pc.c.v[index] = merged;
        HalfBuf(pc.second).v[index] = float16_t(e4m3(merged));
        return;
    }
    if (kind == POOL2_SKIP) {
        /* Block 0's output into both its consumers in one read: the 2x2 pool into the
         * encoder, published (POOL2 with the E4M3 epilogue), and every pixel published to
         * half as the post block's skip (E4M3_HALF) — two passes over a full-resolution
         * float32 frame, 126 MB each at 720p. Their roundings are theirs: the pool adds its
         * four taps column-first (`precise`), the skip publishes each tap alone.
         * n=channels, sb=source width; `second` takes the skip. */
        uint channels = pc.n, width = pc.sb;
        uint c = index % channels, rest = index / channels;
        uint x = rest % (width / 2u), y = rest / (width / 2u);
        uint base = ((2u * y) * width + 2u * x) * channels + c;
        uint taps[4] = uint[4](base, base + width * channels, base + channels,
                                base + (width + 1u) * channels);
        float value[4];
        for (uint t = 0u; t < 4u; t++) value[t] = load_a(taps[t]);
        precise float total = value[0] + value[1];
        total += value[2];
        total += value[3];
        store(index, total * 0.25);
        for (uint t = 0u; t < 4u; t++)
            HalfBuf(pc.second).v[taps[t]] = float16_t(e4m3(value[t]));
        return;
    }
    if (kind == UPSAMPLE_ADD) {
        /* A decoder transition's merge in one pass: the projected level below upsampled 2x
         * (nearest), plus the skip times the per-channel sine, then the publish. That was
         * upsample2, scale_channel and add — three passes, two of them writing float32 for
         * the next to read back. Their roundings are kept: the product is rounded on its
         * own, as scale_channel stored it, and then added, so neither may become a fused
         * multiply-add (`precise`). n=channels, sa=target width, sb=source width, d=sine,
         * b=the skip. With a second output the merge goes there published as well: the
         * 32-channel block's, whose feed-forward reads it published and its residual raw. */
        uint channels = pc.n, target = pc.sa, source = pc.sb;
        uint c = index % channels, rest = index / channels;
        uint x = rest % target, y = rest / target;
        precise float scaled = load_b(index) * pc.d.v[c];
        precise float merged = load_a(((y / 2u) * source + (x / 2u)) * channels + c) + scaled;
        store(index, merged);
        if (pc.second != 0ul) HalfBuf(pc.second).v[index] = float16_t(e4m3(merged));
        return;
    }
    if (kind == PAD_END) {
        // extend to a larger extent with zeros. n=channels, sa=height, sb=width,
        // sc=padded width.
        uint channels = pc.n, height = pc.sa, width = pc.sb, padded = pc.sc;
        uint c = index % channels, rest = index / channels;
        uint x = rest % padded, y = rest / padded;
        store(index, (y < height && x < width)
            ? load_a((y * width + x) * channels + c) : 0.0);
        return;
    }
    if (kind == SCALE_CHANNEL) { store(index, load_a(index) * pc.d.v[index % pc.n]); return; }
    if (kind == ADD)           { store(index, load_a(index) + load_b(index)); return; }
    if (kind == SPLIT_HEADS) {
        // (windows, tokens, 3C) -> one of Q/K/V as (windows, heads, tokens, 32)
        uint channels = pc.n, heads = pc.batch, tokens = pc.sa, part = pc.sb;
        uint d = index % 32u, rest = index / 32u;
        uint token = rest % tokens; rest /= tokens;
        uint head = rest % heads, window = rest / heads;
        store(index, load_a((window * tokens + token) * 3u * channels
                               + part * channels + head * 32u + d));
        return;
    }
    if (kind == MERGE_HEADS) {
        // (windows, heads, tokens, 32) -> (windows, tokens, C)
        uint channels = pc.n, heads = pc.batch, tokens = pc.sa;
        uint c = index % channels, rest = index / channels;
        uint token = rest % tokens, window = rest / tokens;
        uint at = (window * heads + c / 32u) * tokens + token;
        float value = load_a(at * 32u + c % 32u);
        /* Flag 0x20000: the ViT's value sum, rounded to half, times its row's reciprocal
         * from `d` — the softmax's normalisation, which the ViT applies here rather than
         * to the weights (attention.comp, vit_softmax). */
        if ((operation_flags() & 0x20000u) != 0u) {
            precise float scaled = half_round(value) * pc.d.v[at];
            value = half_round(scaled);
        }
        store(index, value);
        return;
    }
    if (kind == ADD_BIAS) {
        // scores are (windows*heads, tokens, tokens); the bias is (heads, tokens, tokens)
        uint plane = pc.n * pc.n, inside = index % plane;
        store(index, load_a(index) + pc.d.v[((index / plane) % pc.batch) * plane + inside]);
        return;
    }
    float value = load_a(index) * pc.p0;
    if (kind == E4M3)      store(index, e4m3(value));
    else if (kind == GATE) store(index, gate_activation(value));
    else if (kind == HALF) store(index, half_round(value));
    else                   store(index, value);
}
