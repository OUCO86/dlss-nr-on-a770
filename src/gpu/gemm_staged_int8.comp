#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * gemm_staged_int8 — the staged GEMM on the integer path, for the eight global blocks.
 *
 * Cooperative-matrix configuration 4 (notes/hw-coopmat.md): sint8 x sint8 -> sint32,
 * M=8 N=16 K=32. A multiply-add covers twice the K of the float configuration in the
 * same time, so the same 64x32 block takes a 64-deep K step and moves the same bytes per
 * step as `gemm_staged.comp` does per 32 — half the trips round the loop for the same
 * work. That loop, not memory, is what the bottleneck's GEMMs wait on
 * (notes/improve-b.md).
 *
 * The weights are stored transposed, N x K, so that a B fragment is read by column —
 * four consecutive K bytes to a word, the order the matrix unit consumes — and the
 * accumulator is exact. The scales come back in the epilogue:
 * C[r][c] = acc[r][c] * a_scale[r] * b_scale[c], one per row of A and one per column of
 * B, which is what makes int8 activations usable at all (`src/gpu/int8_quant.py`).
 *
 * Operands, in the resident push block: a the activations (int8, M x K), b the weights
 * (int8, N x K), c the output (float32, M x N), d the row scales, residual_cos the
 * column scales.
 *
 * Bit 0x100000 is the QKV projection's epilogue (`qkv_epilogue.glsl`): the product is
 * dequantised in place and then normalised and published into Q, K and V, which arrive in
 * `c`, `d` and `residual_cos`, and the row and column scales move to the two words the
 * GEMM's own strides would occupy (`lda`/`ldb`, `ldc`/`spare`) — the same reuse
 * `xmx_rec_qkv` makes of them for its fifth pointer.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shared_memory_block : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "publish.glsl"

/* A770 / Xe-HPG: int8 cooperative matrix is 8x8x32 (configs 1,2), not Xe2's 8x16x32. */
const uint TM = 8, TN = 8, TK = 32;
const uint WARPS = 4;
/* `STAGED_BM` is how many rows a workgroup keeps its accumulators for, and therefore how
 * many accumulator matrices each lane holds: RM = BM / WARPS / TM of them, two at 64 and
 * one at 32. `gemm_staged.comp` has had the choice for a long time — `gemm_staged32.spv`
 * is the 32-row build — and the reason is the same register arithmetic this kernel runs
 * into below. */
#ifndef STAGED_BM
#define STAGED_BM 64
#endif
#ifndef STAGED_BN
#define STAGED_BN 32
#endif
const uint BM = STAGED_BM, BN = STAGED_BN, BK = 64;   // the block, and a K step of two multiply-adds
const uint WM = BM / WARPS, RM = WM / TM, RN = BN / TN;
/* Sixteen bytes of pad keep successive rows off the same banks and every row 16-byte
 * aligned for the vector stores that fill the tiles. */
const uint SA = BK + 16, SB = BK + 16;

layout(local_size_x = 32 * WARPS) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Uvec4Buf { uvec4 v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Vec4Buf  { vec4  v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf { f16vec4 v4[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4)  buffer HalfBuf  { float16_t v[]; };

layout(push_constant, scalar) uniform Push {
    Uvec4Buf a, b; FloatBuf c, d;
    uint m, n, k, batch;
    uint sa, sb, sc, flags;
    float p0, p1, p2, p3;
    /* Offsets 80 and 88 are the GEMM's strides, which this kernel never reads. The QKV
     * epilogue's two scale vectors travel there instead, as `attention.comp`'s query
     * scale already does at 80: the block has no room left to append them. */
    FloatBuf a_scale, b_scale;
    uint64_t residual_cos;                     // the weights' per-column scales
    uint image_h, image_w, window_cols, window_pad;
    uint64_t qkv_scale;
    /* The grouped feed-forward's row strides, past the 128 bytes every Vulkan device
     * owes, where `libxmx.c` puts them: 80 and 88 — every other GEMM's `lda` and
     * `ldc` — hold this kernel's two scale vectors, so there was no room at home.
     * Zero means the dense default, which is what an unbatched call leaves them at. */
    uint blda, bldb, bldc, bspare;
} pc;

#include "specialize.glsl"
#ifdef INT8_RESIDUAL
#include "residual_epilogue.glsl"          // window padding's map into the image
#endif

/* The tiles as bytes for the matrix loads, as 16-byte words for the fills, and the
 * int32 output stage: all the same 8 KB, never live at once. */
layout(scalar) shared Operands  { int8_t buf_a[BM * SA]; int8_t buf_b[BN * SB]; };
layout(scalar) shared OperandsU { uvec4 wa[BM * SA / 16u]; uvec4 wb[BN * SB / 16u]; };
layout(scalar) shared Staging   { int32_t stage[BM * BN]; };

/* The QKV epilogue wants a float stage and there is no room for a second one: another
 * 8 KB would take this workgroup from a 16 KB share of the core's shared memory to a
 * 32 KB one, halving how many of them fit — for every integer GEMM in the graph, not
 * only the ones that use this epilogue. So the dequantised floats are written back over
 * the integers they came from, one word for one word, and the epilogue reads them
 * through the same cast. `QKV_STAGE` is how it writes a float; `QKV_READ`, how it gets
 * one back. */
void qkv_barrier() { barrier(); }
#define QKV_READ(i) intBitsToFloat(stage[i])
#define QKV_STAGE(v) floatBitsToInt(v)
#include "cosine_tree.glsl"
#include "qkv_epilogue.glsl"
#undef QKV_STAGE
#undef QKV_READ

void main() {
    uint row = gl_WorkGroupID.y * BM, col = gl_WorkGroupID.x * BN;
    uint last = pc.m - 1u;
    uint thread = gl_LocalInvocationID.x, warp = thread / 32u;
    /* The group, and where this group's operands start.
     *
     * `sa`/`sb`/`sc` advance the group and are element counts, as they are for every
     * other GEMM; the row strides default to the dense K and N. A batch of one with no
     * strides gives every offset below zero, so the addressing a call already makes is
     * not disturbed by any of this. A zero `sa` broadcasts A, which is what the
     * branched feed-forward wants: one activation, `groups` sets of weights.
     *
     * A and B are read a `uvec4` at a time — sixteen int8 operands to a word — so
     * their counts are divided once here, not per load. The division is exact because
     * the integer GEMM takes K a multiple of 64 and each stride is a whole number of
     * rows or columns of it. */
    uint batch = gl_WorkGroupID.z;
    uint lda = pc.blda != 0u ? pc.blda : pc.k;
    uint ldb = pc.bldb != 0u ? pc.bldb : pc.k;
    uint ldc = pc.bldc != 0u ? pc.bldc : pc.n;
    uint ao = batch * (pc.sa / 16u), bo = batch * (pc.sb / 16u), co = batch * pc.sc;
    uint awords = lda / 16u, bwords = ldb / 16u;
    /* One scale per row of A, and how far apart the groups' are. Zero is the cheap case
     * and the one the grouped feed-forward wants: one quantise pass over the whole wide
     * activation, one scale per row, every group reading the same one. A group of its
     * own would cost a partition first — the slices are column slices of a wider buffer,
     * not consecutive rows — and that is a pass this change exists to avoid paying. */
    uint roff = batch * pc.bspare;
    /* The same for the weights' per-column scales: a strided B gives every group a
     * whole matrix of its own (`sb` is N x K for all four grouped feed-forwards), so
     * its scales are a group's worth apart too. */
    uint soff = pc.sb != 0u ? batch * pc.n : 0u;
    /* A: BM rows of BK bytes. At 64 rows a thread takes two whole words of one row —
     * sixty-four bytes to two of us, and there are 128 of us — and at 32 it takes one
     * word, four of us to a row. B: 32 columns of BK bytes, a thread one word of one
     * column, at either block. */
#if STAGED_BM == 32
    uint ar = thread / 4u, ah = thread % 4u;
#else
    uint ar = thread / 2u, ah = (thread % 2u) * 2u;
#endif
    uint bn = thread / 4u, bh = thread % 4u;

    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[RM][RN];
    for (uint i = 0; i < RM; i++)
        for (uint j = 0; j < RN; j++)
            acc[i][j] = coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0);
    coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> fa[RM];
    coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> fb[RN];

    for (uint k0 = 0; k0 < pc.k; k0 += BK) {
        barrier();
        uint at = ao + min(row + ar, last) * awords + k0 / 16u + ah;
#if STAGED_BM == 32
        uvec4 b0 = pc.b.v[bo + (col + bn) * bwords + k0 / 16u + bh];
        wa[(ar * SA) / 16u + ah] = pc.a.v[at];
#else
        uvec4 a0 = pc.a.v[at], a1 = pc.a.v[at + 1u];
        uvec4 b0 = pc.b.v[bo + (col + bn) * bwords + k0 / 16u + bh];
        wa[(ar * SA) / 16u + ah] = a0;
        wa[(ar * SA) / 16u + ah + 1u] = a1;
#endif
        wb[(bn * SB) / 16u + bh] = b0;
        barrier();
        for (uint kk = 0; kk < BK; kk += TK) {
            for (uint i = 0; i < RM; i++)
                coopMatLoad(fa[i], buf_a, (warp * WM + i * TM) * SA + kk, SA,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0; j < RN; j++)
                coopMatLoad(fb[j], buf_b, (j * TN) * SB + kk, SB,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0; i < RM; i++)
                for (uint j = 0; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(fa[i], fb[j], acc[i][j]);
        }
    }

    barrier();
    for (uint i = 0; i < RM; i++)
        for (uint j = 0; j < RN; j++)
            coopMatStore(acc[i][j], stage, (warp * WM + i * TM) * BN + j * TN, BN,
                         gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    /* Bit 0x100000: the QKV projection's epilogue (qkv_epilogue.glsl), which wants the
     * product as float. Dequantise the block where it stands — the scales are one per row
     * and one per column, as they are for the store below — and hand it over. Rows past M
     * are the clamped last row's, as their operands were: the epilogue never stores them,
     * but it does normalise them, and a half-cast integer would make that a NaN. */
    if ((operation_flags() & 0x100000u) != 0u) {
        for (uint e = thread * 4u; e < BM * BN; e += 32u * WARPS * 4u) {
            uint r = min(row + e / BN, last);
            uint c = col + e % BN;
            float scale = pc.a_scale.v[r];
            vec4 column = Vec4Buf(uint64_t(pc.b_scale)).v[(soff + c) >> 2];
            for (uint q = 0u; q < 4u; q++)
                stage[e + q] = floatBitsToInt(float(stage[e + q]) * scale * column[q]);
        }
        barrier();
        qkv_epilogue(row, col, thread, 32u * WARPS);
        return;
    }
    FloatBuf row_scale = pc.d, column_scale = FloatBuf(pc.residual_cos);
    /* Bits 8-11 pick the epilogue, bit 0x1000 a half output — the same layout every
     * other kernel reads (_publish in xmxres.py). The publish lands after the scales,
     * where the fp16 kernel's lands after its residual: both are the last thing that
     * happens to the value before it is stored. */
    uint epilogue = (operation_flags() >> 8) & 0xFu;
    bool narrow = (operation_flags() & 0x1000u) != 0u;
    /* Bits 0x20000, 0x40000 and 0x80000 are the three `residual_epilogue.glsl` gives
     * the float kernels, and they mean the same here: add `skip * cosine` before the
     * publish, read the skip as half, and write a window block's padded rows back into
     * the unpadded image. Without them this is the pass it always was.
     *
     * The integer path has been paying for its residual with a pass of its own — write
     * the float32 branch out, read it back, add, publish, write again — because the
     * kernel had no epilogue. Folding it in saves both trips over M x N float32. What
     * it costs is two pointers, and the push block has no room: 128 bytes is all a
     * Vulkan device must give and this one already fills it. So they travel in
     * `a_scale` and `b_scale`, the two words at 80 and 88 that the QKV epilogue borrows
     * for its own scales. The epilogues never run together, so neither do the two
     * readings of those words.
     *
     * It costs something else too, and that is why this is a second build of the kernel
     * rather than the only one. Measured with it compiled in unconditionally, every
     * integer product in the frame got slower — all 188 of them, including the ones with
     * no residual to add and bit 0x20000 clear: 8.43 ms became 26.13 ms across the frame,
     * three times the time for instructions those passes did not execute. Eight
     * accumulator matrices are most of the registers a workgroup has and the staging eats
     * what little shared memory is left, so there is nowhere to spill to. `INT8_RESIDUAL`
     * builds the two shapes apart and the runtime binds this one only to the calls that
     * use it. */
#ifdef INT8_RESIDUAL
    bool adding = (operation_flags() & 0x20000u) != 0u;
    bool half_skip = (operation_flags() & 0x40000u) != 0u;
#endif
    for (uint e = thread * 4u; e < BM * BN; e += 32u * WARPS * 4u) {
        uint r = row + e / BN;
        if (r > last) continue;
        uint c = col + e % BN;
        /* Window padding has no place in the image and must not touch the skip. */
#ifdef INT8_RESIDUAL
        uint at = co + r * ldc + c;
        if (adding && !residual_output_index(at)) continue;
#endif
        float scale = row_scale.v[roff + r];
        vec4 column = Vec4Buf(pc.residual_cos).v[(soff + c) >> 2];
        vec4 out4;
#ifdef INT8_RESIDUAL
        if (adding) {
            /* Four consecutive channels stay four-aligned through every map here: `pc.n`
             * is a whole multiple of 32, the offset into it comes from `e % BN`, and an
             * image index moves by `pc.n`. So the skip and the cosine are two loads, not
             * eight, and nothing divides by a count read from the device at run time.
             *
             * Written as the fused multiply-add, not as `branch + skip * cosine`: left to
             * the compiler that form was contracted the other way and missed by an ulp in
             * `ffn_fused.comp`, and `precise` stops it choosing differently here. What has
             * to come out bit-identical is the pass this removes. */
            vec4 skipped = half_skip ? vec4(Half4Buf(uint64_t(pc.a_scale)).v4[at >> 2])
                                     : Vec4Buf(uint64_t(pc.a_scale)).v[at >> 2];
            vec4 cosine = Vec4Buf(uint64_t(pc.b_scale)).v[(at % pc.n) >> 2];
            for (uint q = 0u; q < 4u; q++) {
                precise float total = fma(skipped[q], cosine[q],
                                         float(stage[e + q]) * scale * column[q]);
                out4[q] = publish(epilogue, total);
            }
        } else
#endif
        {
            for (uint q = 0; q < 4u; q++)
                out4[q] = publish(epilogue, float(stage[e + q]) * scale * column[q]);
        }
        /* Where it lands. The two builds differ, and must: `at` has been through
         * `residual_output_index`, which moves a window block's row to its place in the
         * unpadded image, so it is only the plain build's index when there was no map to
         * apply — and the plain build's is written out as it always was, so that the
         * pipeline every integer product already runs on is not rebuilt by this change. */
        if (!narrow)
#ifdef INT8_RESIDUAL
            Vec4Buf(uint64_t(pc.c)).v[at >> 2] = out4;
        else
            Half4Buf(uint64_t(pc.c)).v4[at >> 2] = f16vec4(out4);
#else
            Vec4Buf(uint64_t(pc.c)).v[(co + r * ldc + c) >> 2] = out4;
        else
            Half4Buf(uint64_t(pc.c)).v4[(co + r * ldc + c) >> 2] = f16vec4(out4);
#endif
    }
}
