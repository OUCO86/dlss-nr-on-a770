#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * ffn_fused_int8 — a narrow block's whole feed-forward on the integer path, with the
 * hidden layer kept on chip AND on the integer grid.
 *
 * The chain this replaces for a narrow block's feed-forward: quantise the input, the
 * expand GEMM (K = 32 — too shallow for the staged kernel's 64 gate, which is why
 * these blocks ran the fp16 fused kernel instead), publish a half hidden layer,
 * quantise that, the projection GEMM with the residual. Here the expand reads the
 * quantised input directly at TK = 32 — one multiply-add, exactly the staged
 * kernel's step — keeps the hidden layer in shared as E4M3 bytes (the published
 * values ARE exactly that, so nothing is lost), quantises it where it stands — the
 * whole row is in the subgroup, which is the wall the separate pass existed to work
 * around — and runs the contract from those bytes. The second quantise pass and the
 * hidden round trip go away; the input's stays (the graph already wrote it).
 *
 * Why int8 at all: the width sweep (notes/int8-width-sweep.md, specialized against
 * specialized) — at the frame's FFN shapes the int8 GEMM runs 1.3-1.8x the fp16
 * one. The first build of this kernel lost at 130560x32x128 where the raw GEMM won
 * 1.57x: a 32-element local array spilled (the driver reported scratch 960) and
 * 8-row subgroups doubled the fixed cost per row. This build: 16 rows a subgroup,
 * eight subgroups — 2 KB of hidden bytes + 2 KB of int32 staging a subgroup, 32 KB
 * a workgroup, the budget exactly — and the quantise reads shared twice instead of
 * caching a row in registers. No local array over a handful of words anywhere.
 *
 * Bit-identical to the chain by construction:
 *   expand: one int32 MMA per hidden chunk from zero (K = 32 = one TK step), chunks
 *     ascending; dequantise through shared exactly as gemm_staged_int8's store loop —
 *     float(w) * row_scale * column_scale, left to right — publish(3) (gate then
 *     e4m3), and store the value as its E4M3 code.
 *   quantise: E4M3 codes are monotonic in magnitude, so the largest |code| decodes to
 *     the row peak the half path measured; scale = peak/127 (1.0 for a zero row), one
 *     reciprocal, roundEven and clamp-127 exactly as quantize_row.comp.
 *   contract: the chain's K = 128 walk — hidden columns 0..31, 32..63, 64..95,
 *     96..127 into the same int32 accumulator, four MMAs a fragment; then the
 *     INT8_RESIDUAL store: fma(skip, cosine, float(w) * scale_h * column_scale) under
 *     precise, publish(epilogue).
 * The hidden's row scales travel in the ascale buffer's second half (index M + row):
 * 64 bytes a subgroup through L2 — the shared budget has no room and the registers
 * the first build spent on them spilled.
 *
 * Operands (the struct push layout, offsets in comments): a the quantised input
 * (int8, M x 32), b the expand weights ((hidden x channels) = 128 x 32, the chain's
 * quantise_weight layout), c the output, d the skip (half with 0x40000), ascale at
 * 64 (float32, 2M: input scales then this kernel's hidden scales), col_scales at 72
 * (expand's 128 then contract's 32), ldc at 88, residual_cos at 96, projection at
 * 120 ((channels x hidden) = 32 x 128, the chain's other quantise_weight).
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shared_memory_block : require

#include "publish.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Int8Buf  { int8_t  v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float   v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Vec4Buf  { vec4    v4[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf { f16vec4 v4[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4)  buffer HalfBuf  { float16_t v[]; };

layout(push_constant, scalar) uniform Push {
    Int8Buf a, b; FloatBuf c; HalfBuf d;   // 0,8,16,24
    uint m, n, k, batch;                    // 32
    uint sa, sb, sc, flags;                 // 48
    uint64_t ascale;                        // 64: float32, 2M (input; hidden at M)
    uint64_t col_scales;                    // 72: expand's 128 then contract's 32
    uint lda, ldb, ldc, spare;              // 80
    uint64_t residual_cos;                  // 96
    uint spare3, spare4, spare5, spare6;    // 104
    uint64_t projection;                    // 120
} pc;

#include "specialize.glsl"

/* A770 / Xe-HPG: int8 cooperative matrix is 8x8x32, as gemm_staged_int8.comp takes it. */
const uint TM = 8, TN = 8, TK = 32;
const uint ROWS = 16u, OUT = 32u, HIDDEN = 128u, SUBGROUPS = 8u;
const uint RM = ROWS / TM;                 // 2
const uint RN = OUT / TN;                  // 4

/* 32 KB, every view the same bytes: subgroup s's four kilobytes at 4 KB * s — its
 * hidden rows (E4M3 bytes, then int8 in place) in the low 2 KB, its int32 staging
 * (16 rows x 32 words) in the high 2 KB. */
layout(scalar) shared AsByte { uint8_t  u8[32768]; };
layout(scalar) shared AsI8   { int8_t   i8[32768]; };
layout(scalar) shared AsInt  { int32_t  i32[8192]; };
layout(scalar) shared AsUint { uint     u32[8192]; };

/* The E4M3 code of a value already rounded onto the grid — what publish(3) leaves.
 * 0x7f/0xff cannot appear (publish clamps to 448 = 0x7e and never emits NaN). */
uint e4m3_code(float v)
{
    uint sb = (floatBitsToInt(v) >> 31) << 7;
    float a = abs(v);
    if (a < exp2(-6.0)) return sb | uint(roundEven(a * 512.0));    // subnormal: 2^9 steps
    uint b = floatBitsToInt(a);
    uint e = ((b >> 23) & 0xFFu) - 127u + 7u;
    return sb | (e << 3u) | ((b >> 20) & 7u);
}

/* The value of an E4M3 code: bias 7, subnormals in 2^-9 steps — the exact float32 the
 * chain's half container held. */
float e4m3_value(uint b)
{
    uint exponent = (b >> 3u) & 15u, mantissa = b & 7u;
    float value = exponent == 0u
        ? float(mantissa) * exp2(-9.0)
        : intBitsToFloat(int((exponent + 120u) << 23) | int(mantissa << 20));
    return (b & 0x80u) != 0u ? -value : value;
}

int grid(float v, float reciprocal)
{
    return clamp(int(roundEven(v * reciprocal)), -127, 127);       // quantize_row.comp's
}

void main() {
    uint group = gl_WorkGroupID.y;
    uint sub = gl_SubgroupID;
    uint row = gl_WorkGroupID.x * (ROWS * SUBGROUPS) + sub * ROWS;
    if (row >= pc.m) return;
    uint last = pc.m - 1u;
    uint lane = gl_SubgroupInvocationID;
    uint ldc = pc.ldc != 0u ? pc.ldc : OUT;
    uint hbase = 4096u * sub;                       // hidden bytes (and int8 in place)
    uint stw = (4096u * sub + 2048u) / 4u;          // staging, in int32 words

    FloatBuf ascale = FloatBuf(pc.ascale), col = FloatBuf(pc.col_scales);

    /* The expand's A fragments: the input's 16 rows x 32 int8, two TM tall, clamped
     * to the last row past the end as the staged GEMM clamps its partial block — the
     * surplus rows compute real products and are discarded at the store. */
    coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> fa[RM];
    for (uint i = 0u; i < RM; i++)
        coopMatLoad(fa[i], pc.a.v, min(row + i * TM, last) * 32u, 32u,
                    gl_CooperativeMatrixLayoutRowMajor);

    for (uint c = 0u; c < 4u; c++) {
        /* One int32 MMA a chunk from zero — the chain's expand takes K = 32 as a
         * single TK step in a workgroup of its own; the same B fragments (the same
         * rows of the same (hidden x channels) buffer) in the same chunk order.
         * Eight accumulators live here and again in the contract, never both at
         * once: the peak is 8 + 3 fragments, well clear of the cliff at 16. */
        coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> h[RM][RN];
        for (uint j = 0u; j < RN; j++) {
            coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> w;
            coopMatLoad(w, pc.b.v, (c * 32u + j * 8u) * 32u, 32u,
                        gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                h[i][j] = coopMatMulAdd(fa[i], w,
                    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0));
        }
        subgroupMemoryBarrierShared();           // the previous chunk read staging last
        subgroupBarrier();
        for (uint i = 0u; i < RM; i++)
            for (uint j = 0u; j < RN; j++)
                coopMatStore(h[i][j], i32, stw + (i * TM) * 32u + j * 8u, 32u,
                             gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        /* Dequantise and publish as the chain's expand GEMM's store loop does, then
         * keep the value as its code: the half the chain wrote holds exactly that, and
         * the quantise reads it back from there. */
        for (uint e = lane; e < ROWS * 32u / 4u; e += 32u) {
            uint at = e * 4u;
            uint r = at / 32u, cc = at % 32u;
            float scale = ascale.v[min(row + r, last)];
            for (uint q = 0u; q < 4u; q++) {
                precise float value = float(i32[stw + at + q]) * scale
                                    * col.v[c * 32u + cc + q];
                u8[hbase + r * HIDDEN + c * 32u + cc + q] = uint8_t(e4m3_code(publish(3u, value)));
            }
        }
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    /* The hidden's quantise, in place: two lanes a row, 64 bytes a lane. The row
     * peak is the largest |code| (the codes are monotonic in magnitude) — one pass
     * for the max, one more to decode, quantise and write back. */
    uint r0 = lane / 2u, hw = lane % 2u;
    uint words0 = (hbase + r0 * HIDDEN + hw * 64u) / 4u;
    uint peak_code = 0u;
    for (uint t = 0u; t < 16u; t++) {
        uint x = u32[words0 + t];
        peak_code = max(peak_code, max(x & 0x7Fu, (x >> 8u) & 0x7Fu));
        peak_code = max(peak_code, max((x >> 16u) & 0x7Fu, x >> 24u));
    }
    peak_code = max(peak_code, subgroupShuffleXor(peak_code, 1u));
    float peak = e4m3_value(peak_code);
    float scale = peak == 0.0 ? 1.0 : peak / 127.0;
    float reciprocal = 1.0 / scale;
    if (hw == 0u && row + r0 <= last) ascale.v[pc.m + row + r0] = scale;
    for (uint t = 0u; t < 16u; t++) {
        uint x = u32[words0 + t];
        uint g0 = uint(grid(e4m3_value(x & 0xFFu), reciprocal)) & 0xFFu;
        uint g1 = uint(grid(e4m3_value((x >> 8u) & 0xFFu), reciprocal)) & 0xFFu;
        uint g2 = uint(grid(e4m3_value((x >> 16u) & 0xFFu), reciprocal)) & 0xFFu;
        uint g3 = uint(grid(e4m3_value(x >> 24u), reciprocal)) & 0xFFu;
        u32[words0 + t] = g0 | (g1 << 8u) | (g2 << 16u) | (g3 << 24u);
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    /* The contract: the chain's K = 128 walk in four chunks into the same
     * accumulators. The A fragments come out of the shared bytes just quantised; the
     * B fragments are the chain's (channels x hidden) buffer read column-major,
     * exactly as gemm_staged_int8 reads its (N x K) weights. */
    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> result[RM][RN];
    for (uint c = 0u; c < 4u; c++) {
        coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> g[RM];
        for (uint i = 0u; i < RM; i++)
            coopMatLoad(g[i], i8, hbase + (i * TM) * HIDDEN + c * TK, HIDDEN,
                        gl_CooperativeMatrixLayoutRowMajor);
        for (uint j = 0u; j < RN; j++) {
            coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> w;
            coopMatLoad(w, Int8Buf(pc.projection).v, j * 8u * HIDDEN + c * 32u, HIDDEN,
                        gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++) {
                if (c == 0u)
                    result[i][j] = coopMatMulAdd(g[i], w,
                        coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0));
                else
                    result[i][j] = coopMatMulAdd(g[i], w, result[i][j]);
            }
        }
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    for (uint i = 0u; i < RM; i++)
        for (uint j = 0u; j < RN; j++)
            coopMatStore(result[i][j], i32, stw + (i * TM) * 32u + j * 8u, 32u,
                         gl_CooperativeMatrixLayoutRowMajor);
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    /* The residual and the publish, exactly the chain's INT8_RESIDUAL store loop:
     * fma(skip, cosine, float(w) * row_scale * column_scale) under precise, then
     * publish(epilogue). */
    uint epilogue = (operation_flags() >> 8) & 0xFu;
    bool narrow = (operation_flags() & 0x1000u) != 0u;
    bool half_skip = (operation_flags() & 0x40000u) != 0u;
    Vec4Buf cosine = Vec4Buf(pc.residual_cos);
    for (uint e = lane; e < ROWS * 32u / 4u; e += 32u) {
        uint at0 = e * 4u;
        uint r = at0 / 32u, cc = at0 % 32u;
        if (row + r > last) continue;
        uint at = (row + r) * ldc + group * OUT + cc;
        vec4 skip = half_skip ? vec4(Half4Buf(uint64_t(pc.d)).v4[at >> 2])
                              : Vec4Buf(uint64_t(pc.d)).v4[at >> 2];
        vec4 cosv = cosine.v4[cc >> 2];
        float hs = ascale.v[pc.m + row + r];
        vec4 out4;
        for (uint q = 0u; q < 4u; q++) {
            precise float total = fma(skip[q], cosv[q],
                                      float(i32[stw + at0 + q]) * hs * col.v[128u + cc + q]);
            out4[q] = publish(epilogue, total);
        }
        if (!narrow) {
            for (uint q = 0u; q < 4u; q++) pc.c.v[at + q] = out4[q];
        } else if ((uint(uint64_t(pc.c)) & 7u) == 0u) {
            Half4Buf(uint64_t(pc.c)).v4[at >> 2] = f16vec4(out4);
        } else {
            for (uint q = 0u; q < 4u; q++) HalfBuf(uint64_t(pc.c)).v[at + q] = float16_t(out4[q]);
        }
    }
}
