#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * gemm_staged_int8_fused — the staged GEMM on the integer path, quantising as it goes.
 *
 * `gemm_staged_int8.comp` needs its activations already on the integer grid, and
 * `quantize_row.comp` is what puts them there: a whole pass that reads M x K float16 and
 * writes M x K int8 so that the GEMM can read it back. Measured on the model's shapes,
 * that pass is half again the GEMM it feeds — 14.0 ms of quantising against 6.9 ms of
 * multiplying (`work/int8_cover_out.txt`). The integer path was paying more to get onto
 * the grid than the grid was saving.
 *
 * This kernel reads the activations float16 and quantises them into shared memory on the
 * way in, so nothing is written or read twice. It is otherwise `gemm_staged_int8.comp`
 * exactly: the same int32 accumulator over the whole of K, the same epilogue, the same
 * per-row scale. The scale is passed in rather than measured here, and that is the whole
 * trick — with the scale known before the block is loaded, the accumulator can stay
 * integer for all of K and be scaled once, at the end.
 *
 * It was tried the other way first: the scale measured on chip, over eight rows by
 * sixty-four of K, since a block cannot know the peak of a row it only sees a piece of.
 * That costs the accumulator its integer-ness, because each block's contribution has to
 * be rescaled before it joins the sum, and turning int32 into float32 and scaling it
 * sixty-four times over K=4096 measured 27.1 ms against fp16's 14.8 — three times the
 * 6.9 ms the integer GEMM itself takes. Wrong trade: the arithmetic it saves is a pass,
 * and the arithmetic it buys is an accumulator that can no longer accumulate.
 *
 * What is left is the cost of the quantising itself: reading float16 where the integer
 * path read int8, and a reciprocal, a round and a clamp for each of a thread's
 * thirty-two. One division for the reciprocal, not thirty-two — dividing by the scale
 * instead measured 48.8 ms (`notes/improve-int8-a770.md`).
 *
 * Operands, in the resident push block: a the activations (float16, M x K), b the
 * weights (int8, N x K), c the output (float32, M x N), d the row scales (float32, M),
 * residual_cos the weights' per-column scales.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shared_memory_block : require

/* A770 / Xe-HPG: int8 cooperative matrix is 8x8x32 (configs 1,2), not Xe2's 8x16x32. */
const uint TM = 8, TN = 8, TK = 32;
const uint WARPS = 4;
const uint BM = 64, BN = 32, BK = 64;     // the block, and a K step of two multiply-adds
const uint WM = BM / WARPS, RM = WM / TM, RN = BN / TN;
/* Sixteen bytes of pad keep successive rows off the same banks and every row 16-byte
 * aligned for the vector stores that fill the tiles. */
const uint SA = BK + 16, SB = BK + 16;

layout(local_size_x = 32 * WARPS) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Uvec4Buf { uvec4 v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Vec4Buf  { vec4  v[]; };

layout(push_constant, scalar) uniform Push {
    Uvec4Buf a, b; FloatBuf c, d;
    uint m, n, k, batch;
    uint sa, sb, sc, flags;
    float p0, p1, p2, p3;
    uint lda, ldb, ldc, spare;
    uint64_t residual_cos;                     // the weights' per-column scales
    uint image_h, image_w, window_cols, window_pad;
    uint64_t qkv_scale;
} pc;

/* The tiles as bytes for the matrix loads, as 16-byte words for the fills, and the
 * int32 output stage: all the same 8 KB, never live at once. */
layout(scalar) shared Operands  { int8_t buf_a[BM * SA]; int8_t buf_b[BN * SB]; };
layout(scalar) shared OperandsU { uvec4 wa[BM * SA / 16u]; uvec4 wb[BN * SB / 16u]; };
layout(scalar) shared Staging   { int32_t stage[BM * BN]; };

/* Four int8 into one word, in the order the machine lays bytes out. */
uint pack4(int x0, int x1, int x2, int x3)
{
    return (uint(x0) & 0xffu) | ((uint(x1) & 0xffu) << 8u)
         | ((uint(x2) & 0xffu) << 16u) | ((uint(x3) & 0xffu) << 24u);
}

/* One word's eight float16 onto the integer grid. Multiplied by the reciprocal rather
 * than divided by the scale: it is one division for the block instead of thirty-two.
 * `roundEven` and not `round`, because the host reference is numpy's `np.round`, which
 * is half-to-even, and this is the one place the two have to agree. */
int grid(float v, float reciprocal)
{
    return clamp(int(roundEven(v * reciprocal)), -127, 127);
}

uvec2 quantise8(uvec4 w, float reciprocal)
{
    vec2 a = unpackHalf2x16(w.x), b = unpackHalf2x16(w.y);
    vec2 c = unpackHalf2x16(w.z), d = unpackHalf2x16(w.w);
    return uvec2(pack4(grid(a.x, reciprocal), grid(a.y, reciprocal),
                       grid(b.x, reciprocal), grid(b.y, reciprocal)),
                 pack4(grid(c.x, reciprocal), grid(c.y, reciprocal),
                       grid(d.x, reciprocal), grid(d.y, reciprocal)));
}

void main() {
    uint row = gl_WorkGroupID.y * BM, col = gl_WorkGroupID.x * BN;
    uint last = pc.m - 1u;
    uint thread = gl_LocalInvocationID.x, warp = thread / 32u, lane = thread % 32u;
    /* A: 64 rows of 64 K, a thread thirty-two of one row's K, so two lanes share a row.
     * B: 32 columns of 64 bytes, a thread one word of one column. */
    uint ar = warp * WM + lane / 2u, ah = lane % 2u;
    uint bn = thread / 4u, bh = thread % 4u;

    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[RM][RN];
    for (uint i = 0; i < RM; i++)
        for (uint j = 0; j < RN; j++)
            acc[i][j] = coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0);
    coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> fa[RM];
    coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> fb[RN];

    uint words = pc.k / 16u;                   // a row of B, in 16-byte words
    uint halves = pc.k / 8u;                   // a row of float16 A, in words
    /* The row this thread loads, and the reciprocal that puts it on the grid. Both are
     * the same for every block of K, so the division is done once, not once per block:
     * at 4096 deep that is sixty-four of them, and a division is dearer than the
     * thirty-two multiplies it saves. */
    uint src = min(row + ar, last);
    float reciprocal = 1.0 / pc.d.v[src];
    for (uint k0 = 0; k0 < pc.k; k0 += BK) {
        barrier();
        /* The activations, read float16 and quantised before they are stored. */
        uint at = src * halves + k0 / 8u + ah * 4u;
        uvec2 q0 = quantise8(pc.a.v[at + 0u], reciprocal);
        uvec2 q1 = quantise8(pc.a.v[at + 1u], reciprocal);
        uvec2 q2 = quantise8(pc.a.v[at + 2u], reciprocal);
        uvec2 q3 = quantise8(pc.a.v[at + 3u], reciprocal);
        wa[(ar * SA) / 16u + ah * 2u + 0u] = uvec4(q0.x, q0.y, q1.x, q1.y);
        wa[(ar * SA) / 16u + ah * 2u + 1u] = uvec4(q2.x, q2.y, q3.x, q3.y);
        wb[(bn * SB) / 16u + bh] = pc.b.v[(col + bn) * words + k0 / 16u + bh];
        barrier();
        for (uint kk = 0; kk < BK; kk += TK) {
            for (uint i = 0; i < RM; i++)
                coopMatLoad(fa[i], buf_a, (warp * WM + i * TM) * SA + kk, SA,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0; j < RN; j++)
                coopMatLoad(fb[j], buf_b, (j * TN) * SB + kk, SB,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0; i < RM; i++)
                for (uint j = 0; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(fa[i], fb[j], acc[i][j]);
        }
    }

    barrier();
    for (uint i = 0; i < RM; i++)
        for (uint j = 0; j < RN; j++)
            coopMatStore(acc[i][j], stage, (warp * WM + i * TM) * BN + j * TN, BN,
                         gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    FloatBuf row_scale = pc.d, column_scale = FloatBuf(pc.residual_cos);
    for (uint e = thread * 4u; e < BM * BN; e += 32u * WARPS * 4u) {
        uint r = row + e / BN;
        if (r > last) continue;
        uint c = col + e % BN;
        float scale = row_scale.v[r];
        vec4 column = Vec4Buf(pc.residual_cos).v[c >> 2];
        vec4 out4;
        for (uint q = 0; q < 4u; q++)
            out4[q] = float(stage[e + q]) * scale * column[q];
        Vec4Buf(uint64_t(pc.c)).v[(r * pc.n + c) >> 2] = out4;
    }
}
