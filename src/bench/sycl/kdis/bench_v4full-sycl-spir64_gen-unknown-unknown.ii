                break;
            }
        }
        --_Yx0;
        --_Yx1;
    }

    _Engine _Eng;
    size_t _Nx0;
    size_t _Nx;
    size_t _Wx0;
    _Eres _Yx0;
    _Eres _Yx1;
};

