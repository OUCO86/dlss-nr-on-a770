        const student_t_distribution& _Left, const student_t_distribution& _Right) noexcept {
        return _Left.param() == _Right.param();
    }


    [[nodiscard]] friend bool operator!=(
        const student_t_distribution& _Left, const student_t_distribution& _Right) noexcept {
        return !(_Left == _Right);
    }


