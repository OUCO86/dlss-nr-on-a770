          int N = detail::get_lsc_block_2d_data_size<
              T, NBlocks, BlockHeight, BlockWidth, false, false>()>
inline __attribute__((always_inline)) __attribute__((sycl_explicit_simd)) void
lsc_store_2d(config_2d_mem_access<T, BlockWidth, BlockHeight, NBlocks> &payload,
             sycl::ext::intel::esimd::simd<T, N> Data) {
  using RawT = sycl::ext::intel::esimd::detail::__raw_t<T>;
  sycl::ext::intel::esimd::detail::check_lsc_block_2d_restrictions<
      RawT, BlockWidth, BlockHeight, NBlocks, false, false,
      sycl::ext::intel::esimd::detail::block_2d_op::store>();
  using PropertyListT = sycl::ext::intel::esimd::detail::make_L1_L2_properties_t<L1H, L2H>;
  using CacheVectorT = sycl::ext::intel::esimd::detail::vector_type_t<uint8_t, 2>;
  sycl::ext::intel::esimd::detail::check_cache_hints<sycl::ext::intel::esimd::detail::cache_action::store,
                                 PropertyListT>();

  constexpr uint16_t Mask = 1;
  constexpr CacheVectorT Cache = {static_cast<uint8_t>(L1H),
                                  static_cast<uint8_t>(L2H)};

  __esimd_lsc_store_descriptor<RawT, NBlocks, BlockWidth, BlockHeight, 0, 0, N>(
      Mask, payload.get_raw_data().data(), Data.data(), Cache);
}


