                    esimd::simd<int32_t, 16> acc = esimd::slm_block_load<int32_t, 16>(
                        (uint32_t)((wi_row * 16 + 8 + r) * BN + wi_col * 16) * 4u, esimd::overaligned_tag<16>{});
                    esimd::simd<float, 16> pub = pub_vec_v8<16>(epi, esimd::convert<float>(acc) * rs * cs);
