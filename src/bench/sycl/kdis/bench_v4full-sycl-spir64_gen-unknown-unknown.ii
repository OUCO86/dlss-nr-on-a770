            _Mean = _Tx * _Pp;
            _Gx1 = ::std:: lgamma(_Tx + 1.0);
            _Sqrt = :: sqrt(2 * _Mean * (1 - _Pp));
            _Logp = :: log(_Pp);
            _Logp1 = :: log(1.0 - _Pp);
            _Small._Init(_Mean);
        }

        _Ty _Tx;
        _Ty1 _Px;
        _Ty1 _Pp;
        _Ty1 _Mean;
        _Ty1 _Gx1;
        _Ty1 _Sqrt;
        _Ty1 _Logp;
        _Ty1 _Logp1;

