__attribute__((nodebug)) inline __attribute__((always_inline)) sycl::ext::intel::esimd::simd<T, N> clamp(sycl::ext::intel::esimd::simd<T, N> src, T min_val,
                                         T max_val) {
  sycl::ext::intel::esimd::simd<T, N> MinVal = min_val;
  sycl::ext::intel::esimd::simd<T, N> MaxVal = max_val;
  return clamp(src, MinVal, MaxVal);
}



