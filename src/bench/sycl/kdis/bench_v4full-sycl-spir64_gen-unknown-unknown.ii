                    int rr1 = gr + 8 + r;
                    if (rr1 < M) {
                        float rs = gas[rr1];
                        esimd::simd<int32_t, 16> acc(0);
                        acc.template select<8,1>(0) = c10.template select<8,1>(r*8);
                        acc.template select<8,1>(8) = c11.template select<8,1>(r*8);
