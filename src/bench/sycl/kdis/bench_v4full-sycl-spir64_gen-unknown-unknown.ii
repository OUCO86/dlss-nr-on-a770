template <int N>
inline __attribute__((always_inline)) sycl::ext::intel::esimd::simd<float, N>
atan2_fast(sycl::ext::intel::esimd::simd<float, N> y, sycl::ext::intel::esimd::simd<float, N> x) {

  constexpr float CONST_DBL_EPSILON = 0.00001f;
  sycl::ext::intel::esimd::simd<float, N> OneP(1.0f);
  sycl::ext::intel::esimd::simd<float, N> OneN(-1.0f);
  sycl::ext::intel::esimd::simd<float, N> sign;
  sycl::ext::intel::esimd::simd<float, N> atan2;
  sycl::ext::intel::esimd::simd<float, N> r;
  sycl::ext::intel::esimd::simd_mask<N> mask = x < 0;
  sycl::ext::intel::esimd::simd<float, N> abs_y = sycl::ext::intel::esimd::abs(y) + CONST_DBL_EPSILON;

  r.merge((x + abs_y) / (abs_y - x), (x - abs_y) / (x + abs_y), mask);
  atan2.merge(float(detail::__ESIMD_CONST_PI) * 0.75f,
              float(detail::__ESIMD_CONST_PI) * 0.25f, mask);
  atan2 += (0.1963f * r * r - 0.9817f) * r;

  sign.merge(OneN, OneP, y < 0);

  return atan2 * sign;
}


