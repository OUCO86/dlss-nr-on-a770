template <typename T, class BinaryOperation>
using IsMinimumIdentityOp = std::bool_constant<(
    is_genbool_v<T> || is_geninteger_v<T> ||
    is_genfloat_v<T>)&&IsMinimum<T, BinaryOperation>::value>;


template <typename T, class BinaryOperation>
