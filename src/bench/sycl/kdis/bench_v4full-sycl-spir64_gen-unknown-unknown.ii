inline int getSPIRVNumChannels(int ImageChannelOrder) {
  switch (ImageChannelOrder) {
  case 0:
  case 1:
  case 10:
  case 8:
  case 9:
    return 1;
  case 2:
  case 3:
  case 11:
    return 2;
  case 4:
    return 3;
  case 5:
  case 6:
  case 7:
  case 12:
  case 19:
  case 17:
    return 4;
  case 13:
  case 14:
  case 18:


  default:
    return 0;
  }
}







inline int getSPIRVElementSize(int ImageChannelType, int ImageChannelOrder) {
  int NumChannels = getSPIRVNumChannels(ImageChannelOrder);
  switch (ImageChannelType) {
  case 0:
  case 2:
  case 7:
  case 10:
    return NumChannels;
  case 1:
  case 3:
  case 8:
  case 11:
  case 13:
    return 2 * NumChannels;
  case 4:
  case 5:
    return 2;
  case 6:
    return 4;
  case 9:
  case 12:
  case 14:
    return 4 * NumChannels;
  case 15:
  case 16:
  default:


    return 0;
  }
}

