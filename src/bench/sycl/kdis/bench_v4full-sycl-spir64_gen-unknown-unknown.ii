                        float sc = wbmega::eh_round(QkvScale[0]);
                        esimd::simd<float,32> qv = mulh(mulh(hr, recip), sc);
                        esimd::simd<half,32> oh = esimd::convert<half>(e4m3_vec<32>(qv));
