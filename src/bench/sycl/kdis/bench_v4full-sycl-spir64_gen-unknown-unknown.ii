                       {
        return !(_Left == _Right);
    }


    template <class _Elem, class _Traits>
    friend basic_istream<_Elem, _Traits>& operator>>(basic_istream<_Elem, _Traits>& _Istr,
        fisher_f_distribution& _Dist) {
