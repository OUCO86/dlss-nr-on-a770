inline __attribute__((always_inline)) T unary_op(T X) {
  if constexpr (element_type_traits<T>::use_native_cpp_ops) {
    return unary_op_default<Op>(X);
  } else {
    return scalar_unary_op_traits<Op, T>::impl(X);
  }
}



