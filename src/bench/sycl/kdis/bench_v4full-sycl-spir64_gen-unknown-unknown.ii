                c10 = esimd::xmx::dpas<8, 8, float>(c10, b0, a1);
                c11 = esimd::xmx::dpas<8, 8, float>(c11, b1, a1);
            }

            for (int r = 0; r < 8; ++r) {
                int tok0 = tr * TS + r, tok1 = tok0 + 8;
