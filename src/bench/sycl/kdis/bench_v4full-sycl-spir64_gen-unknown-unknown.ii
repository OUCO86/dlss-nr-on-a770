template <sycl::ext::intel::esimd::atomic_op Op> constexpr int get_num_args() {
  switch (Op) {
  case sycl::ext::intel::esimd::atomic_op::inc:
  case sycl::ext::intel::esimd::atomic_op::dec:
  case sycl::ext::intel::esimd::atomic_op::load:
    return 0;
  case sycl::ext::intel::esimd::atomic_op::xchg:
  case sycl::ext::intel::esimd::atomic_op::store:
  case sycl::ext::intel::esimd::atomic_op::add:
  case sycl::ext::intel::esimd::atomic_op::sub:
  case sycl::ext::intel::esimd::atomic_op::smin:
  case sycl::ext::intel::esimd::atomic_op::smax:
  case sycl::ext::intel::esimd::atomic_op::umin:
  case sycl::ext::intel::esimd::atomic_op::umax:
  case sycl::ext::intel::esimd::atomic_op::fadd:
  case sycl::ext::intel::esimd::atomic_op::fsub:
  case sycl::ext::intel::esimd::atomic_op::fmin:
  case sycl::ext::intel::esimd::atomic_op::fmax:
  case sycl::ext::intel::esimd::atomic_op::bit_and:
  case sycl::ext::intel::esimd::atomic_op::bit_or:
  case sycl::ext::intel::esimd::atomic_op::bit_xor:
    return 1;
  case sycl::ext::intel::esimd::atomic_op::cmpxchg:
  case sycl::ext::intel::esimd::atomic_op::fcmpxchg:
    return 2;
  default:
    return -1;
  }
}

template <sycl::ext::intel::esimd::native::lsc::atomic_op Op> constexpr int get_num_args() {
  return get_num_args<to_atomic_op<Op>()>();
}

