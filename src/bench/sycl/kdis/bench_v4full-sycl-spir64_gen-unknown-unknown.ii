            return _Res;
        } else if (_Par0._Mean < 1.0) {

            const _Ty1 _Rand = _Nrand_impl<_Ty1>(_Eng);






            const _Ty1 _Ub =
                (::std:: min) (_Par0._Mean, _Ty1{3.678794411714423216e-1} * _Par0._Pp + _Ty1{6.32120558828557678e-1});
            if (_Rand > _Ub) {
