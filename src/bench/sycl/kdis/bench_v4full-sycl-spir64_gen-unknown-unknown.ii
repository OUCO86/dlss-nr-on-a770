  using type = std::tuple<typename simd2spmd<T>::type...>;
};

template <class T>
struct simd2spmd<T, std::enable_if_t<std::is_arithmetic_v<T>>> {
  using type = uniform<T>;
};


template <class T, int N> struct simd2spmd<simd_mask<T, N>> {
  using type = bool;
