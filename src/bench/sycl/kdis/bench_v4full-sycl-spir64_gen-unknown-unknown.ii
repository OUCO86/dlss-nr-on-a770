template <typename T, typename T0, typename T1, int N>
__attribute__((nodebug)) inline __attribute__((always_inline)) sycl::ext::intel::esimd::simd<T, N> imul_impl(sycl::ext::intel::esimd::simd<T, N> &rmd,
                                             sycl::ext::intel::esimd::simd<T0, N> src0,
                                             sycl::ext::intel::esimd::simd<T1, N> src1) {
  static_assert(sycl::ext::intel::esimd::detail::is_dword_type<T>::value &&
                    sycl::ext::intel::esimd::detail::is_dword_type<T0>::value &&
                    sycl::ext::intel::esimd::detail::is_dword_type<T1>::value,
                "expected 32-bit integer vector operands.");
  using Comp32T = sycl::ext::intel::esimd::detail::computation_type_t<T0, T1>;
  auto Src0 = src0.template bit_cast_view<Comp32T>();
  auto Src1 = src1.template bit_cast_view<Comp32T>();


  using Comp64T =
      std::conditional_t<std::is_signed_v<Comp32T>, int64_t, uint64_t>;
  sycl::ext::intel::esimd::simd<Comp64T, N> Product64 = Src0;
  Product64 *= Src1;


  auto Product32 = Product64.template bit_cast_view<T>();
  if constexpr (N == 1) {
    rmd = Product32[0];
    return Product32[1];
  } else {
    rmd = Product32.template select<N, 2>(0);
    return Product32.template select<N, 2>(1);
  }
}





