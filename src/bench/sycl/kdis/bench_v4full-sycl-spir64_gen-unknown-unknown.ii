template <sycl::ext::intel::esimd::atomic_op Op, typename T, int N, unsigned NumSrc,
          bool IsLSC = false>
constexpr void check_atomic() {

  static_assert(sizeof(T) > 1, "Unsupported data type");


  if constexpr (!IsLSC)
    static_assert((detail::isPowerOf2(N, 32)),
                  "Execution size 1, 2, 4, 8, 16, 32 are supported");

  static_assert(NumSrc == sycl::ext::intel::esimd::detail::get_num_args<Op>(),
                "Wrong number of operands");
  constexpr bool IsInt2BytePlus =
      std::is_integral_v<T> && (sizeof(T) >= sizeof(uint16_t));

  if constexpr (Op == sycl::ext::intel::esimd::atomic_op::xchg ||
                Op == sycl::ext::intel::esimd::atomic_op::cmpxchg ||
                Op == sycl::ext::intel::esimd::atomic_op::inc ||
                Op == sycl::ext::intel::esimd::atomic_op::dec) {

    static_assert(IsInt2BytePlus, "Integral 16-bit or wider type is expected");
  }

  if constexpr (Op == sycl::ext::intel::esimd::atomic_op::fmax ||
                Op == sycl::ext::intel::esimd::atomic_op::fmin ||
                Op == sycl::ext::intel::esimd::atomic_op::fadd ||
                Op == sycl::ext::intel::esimd::atomic_op::fsub ||
                Op == sycl::ext::intel::esimd::atomic_op::fcmpxchg) {
    static_assert(is_type<T, float, sycl::half, double>(), "float, double or sycl::half type is expected");;
  }
  if constexpr (Op == sycl::ext::intel::esimd::atomic_op::add ||
                Op == sycl::ext::intel::esimd::atomic_op::sub ||
                Op == sycl::ext::intel::esimd::atomic_op::umin ||
                Op == sycl::ext::intel::esimd::atomic_op::umax ||
                Op == sycl::ext::intel::esimd::atomic_op::bit_and ||
                Op == sycl::ext::intel::esimd::atomic_op::bit_or ||
                Op == sycl::ext::intel::esimd::atomic_op::bit_xor ||
                Op == sycl::ext::intel::esimd::atomic_op::smin ||
                Op == sycl::ext::intel::esimd::atomic_op::smax) {
    static_assert(IsInt2BytePlus, "Integral 16-bit or wider type is expected");
    constexpr bool IsSignedMinmax = (Op == sycl::ext::intel::esimd::atomic_op::smin) ||
                                    (Op == sycl::ext::intel::esimd::atomic_op::smax);
    constexpr bool IsUnsignedMinmax = (Op == sycl::ext::intel::esimd::atomic_op::umin) ||
                                      (Op == sycl::ext::intel::esimd::atomic_op::umax);

    if constexpr (IsSignedMinmax || IsUnsignedMinmax) {
      constexpr bool SignOK = std::is_signed_v<T> == IsSignedMinmax;
      static_assert(SignOK, "Signed/unsigned integer type expected for "
                            "signed/unsigned min/max operation");
    }
  }
}

}
