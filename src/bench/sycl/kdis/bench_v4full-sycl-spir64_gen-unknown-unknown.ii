template <typename T, int N>
__attribute__((nodebug)) inline __attribute__((always_inline)) sycl::ext::intel::esimd::simd<T, N> clamp(sycl::ext::intel::esimd::simd<T, N> src,
                                         sycl::ext::intel::esimd::simd<T, N> min_val,
                                         sycl::ext::intel::esimd::simd<T, N> max_val) {
  sycl::ext::intel::esimd::simd<T, N> Result = src;
  Result.merge(min_val, src < min_val);
  Result.merge(max_val, src > max_val);
  return Result;
}
